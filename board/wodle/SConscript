from building import *

cwd = GetCurrentDir()

src = Glob('./*.c')
path =  [cwd, 
         os.path.join(cwd, '../include')]

group = DefineGroup('Drivers', src, depend = ['BSP_USING_BOARD_WODLE'], CPPPATH = path)

# Include the shared sf32lb52-lcd_base bsp exactly once, gated on OUR unique board symbol
# (see hcpu/Kconfig.board) so the stock n16r8 board doesn't also pull it in (double-link).
if GetDepend('BSP_USING_BOARD_WODLE'):
    group = group + SConscript('../sf32lb52-lcd_base/script/SConscript')

Return('group')
