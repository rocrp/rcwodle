from building import *

cwd = GetCurrentDir()

# Staged port: batches are appended as their shims/deps land (see
# docs/superpowers/plans/2026-06-05-crosspoint-port-plan.md).

# --- batch 1: PORTABLE libs + Logging ---------------------------------------
src = Glob('lib/uzlib/src/*.c')
# xmltok_impl.c / xmltok_ns.c are #include'd by xmltok.c — not standalone TUs.
src += ['lib/expat/xmlparse.c', 'lib/expat/xmlrole.c', 'lib/expat/xmltok.c']
src += Glob('lib/Utf8/*.cpp')
src += Glob('lib/JsonParser/*.cpp')
src += Glob('lib/I18n/*.cpp')
src += Glob('lib/InflateReader/*.cpp')
src += Glob('lib/FsHelpers/*.cpp')
src += Glob('lib/Logging/*.cpp')

CPPPATH = [cwd + '/lib/' + d for d in [
    'uzlib/src', 'expat', 'Utf8', 'JsonParser', 'I18n', 'Memory',
    'InflateReader', 'FsHelpers', 'XmlParserUtils', 'Logging',
]]

CPPDEFINES = [
    'XML_GE=0',                  # upstream platformio.ini build_flags
    'XML_CONTEXT_BYTES=1024',
    'ENABLE_SERIAL_LOG',
    'LOG_LEVEL=2',
]

# --- batch 2: book pipeline (LIGHT libs over the shims + port/hal) ----------
src += Glob('lib/ZipFile/*.cpp')
src += Glob('lib/Txt/*.cpp')
src += Glob('lib/Xtc/*.cpp') + Glob('lib/Xtc/Xtc/*.cpp')
src += Glob('lib/MiniBidi/*.cpp')
src += Glob('lib/Serialization/*.cpp')
src += Glob('lib/Epub/*.cpp') + Glob('lib/Epub/Epub/*.cpp')      + Glob('lib/Epub/Epub/css/*.cpp') + Glob('lib/Epub/Epub/parsers/*.cpp') \
     + Glob('lib/Epub/Epub/blocks/*.cpp') + Glob('lib/Epub/Epub/converters/*.cpp') \
     + Glob('lib/Epub/Epub/hyphenation/*.cpp')

src += Glob('lib/JpegToBmpConverter/*.cpp')
src += Glob('lib/PngToBmpConverter/*.cpp')
# bitbank2 decoders (vendored from upstream .pio/libdeps); exclude ESP32-S3 .S
src += Glob('extlib/JPEGDEC/src/*.cpp')
src += Glob('extlib/PNGdec/src/*.c') + Glob('extlib/PNGdec/src/*.cpp')

CPPPATH += [cwd + '/lib/' + d for d in [
    'ZipFile', 'Txt', 'Xtc', 'MiniBidi', 'Serialization', 'Epub',
    'JpegToBmpConverter', 'PngToBmpConverter', 'GfxRenderer', 'EpdFont',
]]
CPPPATH += [cwd + '/extlib/JPEGDEC/src', cwd + '/extlib/PNGdec/src']

group = DefineGroup('CrossPointVendor', src, depend=[''],
                    CPPPATH=CPPPATH, CPPDEFINES=CPPDEFINES)

Return('group')
